# ---------------------------------------------------------------------------
# ActionDoc AI - environment variables
# Copy to `.env.local` and fill in real values. Never commit real credentials.
#
# Only MONGODB_URI and AUTH_SECRET are strictly required. Every other block
# enables a capability; the application degrades gracefully without it and the
# Settings page reports the live status of each integration.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MongoDB Atlas or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/actiondoc

# Auth.js / NextAuth v5 - generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# OpenAI - server-side only. Never expose to the browser.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_INPUT_CHARS=48000

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO)
# STORAGE_DRIVER=s3 uses the S3 settings below. Set to `memory` for
# dependency-free local development - objects then live in process memory and
# are lost on restart, so never use it in production.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=actiondoc-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Redis (BullMQ). Upstash / Redis Cloud / local redis-server
REDIS_URL=redis://127.0.0.1:6379
DOCUMENT_QUEUE_CONCURRENCY=2
ENABLE_INLINE_WORKER=false

# Email (Resend)
RESEND_API_KEY=replace-me
EMAIL_FROM=ActionDoc AI <notifications@actiondoc.ai>

# Rate limiting / app tuning
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_UPLOAD_BYTES=26214400
